# SMTP de Hostinger para el formulario de contacto.
# Copia este archivo a .env.local para desarrollo y replica las mismas
# variables en Vercel (Project Settings > Environment Variables).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=tats@tatsmusic.com
SMTP_PASS=la-contrasena-del-buzon

# Opcional: destinatario de los mensajes del formulario.
# Si se omite, se usa el correo de lib/site.ts (tats@tatsmusic.com).
CONTACT_TO=tats@tatsmusic.com
